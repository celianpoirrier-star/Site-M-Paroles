---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Hills from '../components/Hills.astro';
import CommunicationAnimale from '../components/CommunicationAnimale.astro';
import Fonctionnement from '../components/Fonctionnement.astro';
import QuandConsulter from '../components/QuandConsulter.astro';
import Deroulement from '../components/Deroulement.astro';
import Tarifs from '../components/Tarifs.astro';
import QuiSuisJe from '../components/QuiSuisJe.astro';
import Engagement from '../components/Engagement.astro';
import Reserver from '../components/Reserver.astro';
import MentionsLegales from '../components/MentionsLegales.astro';
---

<Base>
  <Hero />
  <CommunicationAnimale />
  <Hills from="sage" to="paper" />
  <Fonctionnement />
  <Hills to="sand" />
  <QuandConsulter />
  <Hills from="sand" to="paper" />
  <Deroulement />
  <Hills to="forest" />
  <Tarifs />
  <Hills from="forest" to="paper" />
  <QuiSuisJe />
  <Hills to="sage" />
  <Engagement />
  <Hills from="sage" to="paper" />
  <Reserver />
  <MentionsLegales />
</Base>
