---
import Base from '../layouts/Base.astro';
import Hills from '../components/Hills.astro';
import Deroulement from '../components/Deroulement.astro';
import Tarifs from '../components/Tarifs.astro';
import NextPage from '../components/NextPage.astro';
import { site } from '../data/content';
---

<Base title={`Déroulement et tarifs · ${site.name}`}>
  <Deroulement />
  <Hills to="forest" />
  <Tarifs />
  <Hills from="forest" to="paper" />
  <NextPage href="/reserver" label="Réservez votre séance" />
</Base>
