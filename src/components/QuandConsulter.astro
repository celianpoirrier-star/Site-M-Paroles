---
import { quandConsulter } from '../data/content';
---

<section class="section section--sand" data-nav-section="communication-animale" aria-labelledby="quand-title">
  <div class="container">
    <header class="quand__head reveal">
      <p class="eyebrow">{quandConsulter.eyebrow}</p>
      <h2 id="quand-title">{quandConsulter.title}</h2>
    </header>

    <ul class="quand__list">
      {
        quandConsulter.situations.map((s, i) => (
          <li class="situation reveal" style={`transition-delay:${i * 70}ms`}>
            <span class="situation__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <aside class="warning reveal" aria-label="Important">
      <svg class="warning__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 5a1.2 1.2 0 0 1 1.2 1.2v4.6a1.2 1.2 0 0 1-2.4 0V8.2A1.2 1.2 0 0 1 12 7Zm0 8.4a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6Z"
        ></path>
      </svg>
      <div>
        <p class="warning__title">Important</p>
        <p>{quandConsulter.warning}</p>
      </div>
    </aside>
  </div>
</section>

<style>
  .quand__head {
    max-width: 44rem;
  }

  .quand__list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    margin: 2.5rem 0 3rem;
    padding: 0;
    list-style: none;
    border-top: 1px solid rgb(31 77 58 / 0.15);
  }

  .situation {
    display: flex;
    gap: 1rem;
    padding: 1.75rem 1.5rem 1.75rem 0;
    border-bottom: 1px solid rgb(31 77 58 / 0.15);
  }

  .situation__num {
    font-family: var(--font-title);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ochre-deep);
    padding-top: 0.15rem;
  }

  .situation h3 {
    font-size: 1.15rem;
    margin-bottom: 0.35rem;
  }

  .situation p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
  }

  .warning {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    padding: 1.5rem 1.75rem;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1.5px solid var(--ochre);
  }

  .warning__icon {
    flex: none;
    width: 1.75rem;
    color: var(--ochre);
  }

  .warning__title {
    margin: 0 0 0.25rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 0.8125rem;
    color: var(--ochre-deep);
  }

  .warning p:last-child {
    margin: 0;
  }

  @media (max-width: 900px) {
    .quand__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .quand__list {
      grid-template-columns: 1fr;
    }
  }
</style>
