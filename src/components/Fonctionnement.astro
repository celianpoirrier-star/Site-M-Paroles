---
import { fonctionnement } from '../data/content';
---

<section class="section" data-nav-section="communication-animale" aria-labelledby="fonctionnement-title">
  <div class="container">
    <header class="fct__head reveal">
      <p class="eyebrow">{fonctionnement.eyebrow}</p>
      <h2 id="fonctionnement-title">{fonctionnement.title}</h2>
      {fonctionnement.intro.map((p) => <p class="lead">{p}</p>)}
    </header>

    <ul class="fct__aspects">
      {
        fonctionnement.aspects.map((a, i) => (
          <li class="aspect reveal" style={`transition-delay:${i * 80}ms`}>
            <span class="aspect__dot" aria-hidden="true" />
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </li>
        ))
      }
    </ul>

    <div class="fct__outro reveal">
      {fonctionnement.outro.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>

<style>
  .fct__head {
    max-width: 48rem;
  }

  .fct__head .lead {
    max-width: none;
  }

  .fct__aspects {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12.5rem, 1fr));
    gap: 1.25rem;
    margin: 3rem 0;
    padding: 0;
    list-style: none;
  }

  .aspect {
    padding: 1.75rem 1.5rem;
    border-radius: var(--radius) var(--radius) var(--radius) 0.5rem;
    background: var(--surface);
    border: 1px solid rgb(31 77 58 / 0.08);
    box-shadow: var(--shadow);
  }

  .aspect:nth-child(even) {
    border-radius: var(--radius) var(--radius) 0.5rem var(--radius);
  }

  .aspect__dot {
    display: block;
    width: 2.25rem;
    height: 2.25rem;
    margin-bottom: 1.1rem;
    border-radius: 60% 40% 55% 45% / 50% 60% 40% 50%;
    background: var(--straw);
  }

  .aspect:nth-child(3n + 2) .aspect__dot {
    background: var(--sage);
  }

  .aspect:nth-child(3n) .aspect__dot {
    background: var(--ochre);
    opacity: 0.75;
  }

  .aspect h3 {
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
  }

  .aspect p {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
  }

  .fct__outro {
    max-width: 48rem;
    margin-left: auto;
    padding-left: 1.5rem;
    border-left: 2px solid var(--sage);
  }

  .fct__outro p:last-child {
    margin-bottom: 0;
    font-family: var(--font-title);
    font-style: italic;
    font-size: 1.2rem;
    color: var(--forest);
  }
</style>
