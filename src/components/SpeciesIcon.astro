---
import type { Species } from '../data/content';

interface Props {
  species: Species;
  class?: string;
}

const { species, class: className, ...rest } = Astro.props;

function pathFor(s: Species): string {
  switch (s) {
    case 'chien':
      return 'M7 6.5c0-1.4 1.6-2.5 5-2.5s5 1.1 5 2.5c1.6.2 3 1.4 3 3.3 0 1.9-.9 3.7-2.2 4.2.1.3.2.7.2 1 0 2.8-2.7 5-6 5s-6-2.2-6-5c0-.3.1-.7.2-1C4.9 13.5 4 11.7 4 9.8c0-1.9 1.4-3.1 3-3.3Zm3 6.2a1 1 0 1 0 0-2 1 1 0 0 0 0 2Zm4 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2Zm-2 4.3c1 0 1.8-.6 1.8-1.2S13 15 12 15s-1.8.2-1.8.8.8 1.2 1.8 1.2Z';
    case 'chat':
      return 'M5 3.5 8.6 7a9 9 0 0 1 6.8 0L19 3.5c.4-.4 1 0 1 .5V11c0 4.7-3.6 8.5-8 8.5S4 15.7 4 11V4c0-.5.6-.9 1-.5Zm5 9.2a1 1 0 1 0 0-2 1 1 0 0 0 0 2Zm4 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2Zm-2 3.3 1.2-1.2h-2.4L12 16Z';
    case 'cheval':
      return 'M12 3a8 8 0 0 0-8 8c0 3 1 6 2.4 8.4.3.5 1 .7 1.5.4l1-.6c.5-.3.7-.9.4-1.4C8.3 15.9 7.6 13.6 7.6 11a4.4 4.4 0 0 1 8.8 0c0 2.6-.7 4.9-1.7 6.8-.3.5-.1 1.1.4 1.4l1 .6c.5.3 1.2.1 1.5-.4C19 17 20 14 20 11a8 8 0 0 0-8-8Zm-6.2 7.5a.9.9 0 1 0 0-1.8.9.9 0 0 0 0 1.8Zm12.4 0a.9.9 0 1 0 0-1.8.9.9 0 0 0 0 1.8ZM6.6 14.5a.9.9 0 1 0 0-1.8.9.9 0 0 0 0 1.8Zm10.8 0a.9.9 0 1 0 0-1.8.9.9 0 0 0 0 1.8Z';
    default: {
      const exhaustive: never = s;
      throw new Error(`Unknown species: ${exhaustive}`);
    }
  }
}
---

<svg class={className} viewBox="0 0 24 24" aria-hidden="true" {...rest}>
  <path fill="currentColor" fill-rule="evenodd" d={pathFor(species)}></path>
</svg>
