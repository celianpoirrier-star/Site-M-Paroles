---
import { communication } from '../data/content';
---

<section
  class="section section--sage"
  id="communication-animale"
  data-nav-section="communication-animale"
  aria-labelledby="ca-title"
>
  <div class="container ca">
    <div class="ca__intro reveal">
      <p class="eyebrow">{communication.eyebrow}</p>
      <h2 id="ca-title">{communication.title}</h2>
    </div>
    <div class="ca__text reveal">
      {communication.paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <blockquote class="ca__highlight reveal">
      <p>{communication.highlight}</p>
    </blockquote>
  </div>
</section>

<style>
  .ca {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 1rem clamp(2rem, 6vw, 5rem);
  }

  .ca__intro {
    grid-row: span 2;
  }

  .ca__text p:first-child::first-letter {
    float: left;
    font-family: var(--font-title);
    font-size: 3.6em;
    line-height: 0.85;
    padding: 0.08em 0.12em 0 0;
    color: var(--ochre);
  }

  .ca__highlight {
    position: relative;
    margin: 1rem 0 0;
    padding: 1.75rem 2rem 1.75rem 2.5rem;
    border-radius: var(--radius) var(--radius) var(--radius) 0.5rem;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .ca__highlight::before {
    content: '';
    position: absolute;
    left: 1.1rem;
    top: 1.5rem;
    bottom: 1.5rem;
    width: 3px;
    border-radius: 3px;
    background: var(--ochre);
  }

  .ca__highlight p {
    margin: 0;
    font-family: var(--font-title);
    font-size: 1.3rem;
    font-style: italic;
    line-height: 1.45;
    color: var(--forest);
  }

  @media (max-width: 860px) {
    .ca {
      grid-template-columns: 1fr;
    }

    .ca__intro {
      grid-row: auto;
    }
  }
</style>
