---
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<div class="container next-page">
  <a href={href} class="btn btn--primary">{label}</a>
</div>

<style>
  .next-page {
    display: flex;
    justify-content: center;
    padding-block: 1rem 4rem;
  }
</style>
