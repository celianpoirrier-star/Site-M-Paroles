---
import Hills from './Hills.astro';
import Leaf from './Leaf.astro';
import Empreinte from './Empreinte.astro';
import { hero, site } from '../data/content';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <Leaf class="hero__leaf hero__leaf--a" />
  <Leaf class="hero__leaf hero__leaf--b" />

  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">{site.slogan}</p>
      <h1 id="hero-title">{hero.title}</h1>
      <p class="lead">{hero.text}</p>
      <div class="hero__actions">
        <a href="/reserver" class="btn btn--primary">Réserver une séance</a>
        <a href="/deroulement-tarifs" class="btn btn--ghost">Comment ça se passe</a>
      </div>
    </div>

    <figure class="compagnons">
      <figcaption class="compagnons__title">{hero.card.title}</figcaption>
      <blockquote class="compagnons__quote">
        <p>{hero.card.quote}</p>
      </blockquote>
      <ul class="compagnons__list">
        {
          hero.card.species.map((s, i) => (
            <li class="compagnon reveal" style={`transition-delay:${i * 120}ms`}>
              <span class="compagnon__print">
                <Empreinte species={s.species} />
              </span>
              {s.label}
            </li>
          ))
        }
      </ul>
    </figure>
  </div>

  <Hills to="sage" />
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(2rem, 6vw, 4.5rem);
    background:
      radial-gradient(60rem 30rem at 85% 10%, rgb(232 199 122 / 0.35), transparent 60%),
      radial-gradient(40rem 30rem at 0% 90%, rgb(168 195 160 / 0.35), transparent 65%);
  }

  .hero__grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: center;
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .hero__copy h1 {
    margin-bottom: 1.5rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }

  .hero__leaf {
    position: absolute;
    color: var(--sage);
    opacity: 0.45;
    pointer-events: none;
  }

  .hero__leaf--a {
    width: 7rem;
    top: 2rem;
    left: -2rem;
    transform: rotate(-35deg);
  }

  .hero__leaf--b {
    width: 9rem;
    bottom: 3rem;
    right: -2.5rem;
    transform: rotate(140deg);
    color: var(--ochre);
    opacity: 0.25;
  }

  /* Compagnons */
  .compagnons {
    margin: 0;
    padding: clamp(1.75rem, 4vw, 2.5rem);
    border-radius: var(--radius-lg) var(--radius-lg) var(--radius-lg) 0.75rem;
    background: rgb(251 247 238 / 0.85);
    border: 1px solid rgb(201 138 61 / 0.25);
    box-shadow: var(--shadow);
    backdrop-filter: blur(6px);
    text-align: center;
  }

  .compagnons__title {
    font-weight: 800;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ochre-deep);
  }

  .compagnons__quote {
    margin: 1rem 0 2rem;
  }

  .compagnons__quote p {
    margin: 0;
    font-family: var(--font-title);
    font-style: italic;
    font-size: clamp(1.3rem, 2.4vw, 1.6rem);
    line-height: 1.4;
    color: var(--forest);
  }

  .compagnons__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem 1.5rem;
    margin: 0;
    padding: 1.5rem 0 0;
    border-top: 1px dashed rgb(31 77 58 / 0.18);
    list-style: none;
  }

  .compagnon {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink-soft);
  }

  .compagnon__print {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--straw);
    color: var(--forest);
    transform: rotate(-12deg);
  }

  .compagnon:nth-child(even) {
    margin-top: 1.25rem;
  }

  .compagnon:nth-child(even) .compagnon__print {
    background: var(--mint);
    transform: rotate(10deg);
  }

  .compagnon__print svg {
    width: 1.8rem;
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }

    .compagnons {
      max-width: 34rem;
    }
  }

  @media (max-width: 480px) {
    .compagnons {
      border-radius: var(--radius);
    }

    .compagnon:nth-child(even) {
      margin-top: 0;
    }
  }
</style>
