---
import { engagement } from '../data/content';
---

<section class="section section--sage" data-nav-section="qui-suis-je" aria-labelledby="engagement-title">
  <div class="container eng">
    <header class="eng__head reveal">
      <p class="eyebrow">{engagement.eyebrow}</p>
      <h2 id="engagement-title">{engagement.title}</h2>
    </header>

    <div class="eng__text reveal">
      {engagement.paragraphs.map((p) => <p>{p}</p>)}
    </div>

    <ul class="values reveal" aria-label="Mes valeurs">
      {engagement.values.map((v) => <li>{v}</li>)}
    </ul>

    <blockquote class="eng__quote reveal">
      <p>{engagement.quote}</p>
    </blockquote>
  </div>
</section>

<style>
  .eng {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 1.5rem clamp(2rem, 6vw, 5rem);
  }

  .eng__text p:last-child {
    margin-bottom: 0;
  }

  .values {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .values li {
    padding: 0.65rem 1.4rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1.5px solid rgb(31 77 58 / 0.12);
    font-family: var(--font-title);
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--forest);
  }

  .values li:nth-child(3n + 1) {
    background: var(--straw);
    border-color: transparent;
  }

  .eng__quote {
    grid-column: 1 / -1;
    margin: 2.5rem 0 0;
    text-align: center;
  }

  .eng__quote p {
    margin: 0;
    font-family: var(--font-title);
    font-style: italic;
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    line-height: 1.3;
    color: var(--forest);
  }

  .eng__quote p::before,
  .eng__quote p::after {
    color: var(--ochre);
  }

  .eng__quote p::before {
    content: '« ';
  }

  .eng__quote p::after {
    content: ' »';
  }

  @media (max-width: 860px) {
    .eng {
      grid-template-columns: 1fr;
    }
  }
</style>
